{
	"name": "PlaneSign Development",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile",
		"args": {
			"PLANESIGN_ROOT": "/workspaces/PlaneSign"
		}
	},
	"runArgs": ["--privileged", "--network=host"],
	"features": {
		"ghcr.io/devcontainers-extra/features/apt-packages:1": {
			"packages": "python3-dev,python3-pil,build-essential,cmake"
		},
		"ghcr.io/devcontainers-extra/features/uv:1.0.2": {},
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"containerEnv": {
		"CFLAGS": "-I/usr/include/python3.12"
	},
	"postCreateCommand": "uv sync --frozen --no-install-project --no-dev",
	"forwardPorts": [80, 443, 5055, 5056],
	"portsAttributes": {
		"80": { "label": "PlaneSign HTTP", "protocol": "http" },
		"443": { "label": "PlaneSign HTTPS", "protocol": "https" },
		"5055": { "label": "Flask API" },
		"5056": { "label": "Emulated Display WebSocket" }
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.debugpy",
				"ms-azuretools.vscode-docker",
				"charliermarsh.ruff"
			]
		}
	}
}
