{
	"name": "PlaneSign Development",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile",
		"args": {
			"PLANESIGN_ROOT": "/workspaces/PlaneSign"
		}
	},
	"runArgs": ["--privileged", "--network=host"],
	// The workspace is the Pi's ~/PlaneSign, where the production container also logs.
	// A separate file keeps the two from rotating each other's log at midnight.
	"containerEnv": {
		"PLANESIGN_LOG_FILE": "logs/planesign-dev.log"
	},
	// Run as Ubuntu's uid-1000 user so files written to the bind-mounted
	// workspace stay owned by the Pi's pi user; root work goes through sudo.
	"remoteUser": "ubuntu",
	// Keep the container's venv off the host: the Pi's Python differs, so a
	// shared .venv only works in whichever environment created it.
	"mounts": [
		"source=planesign-venv-${devcontainerId},target=${containerWorkspaceFolder}/.venv,type=volume"
	],
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"username": "ubuntu",
			"addGroups": "audio",
			"installZsh": false,
			"installOhMyZsh": false,
			"installOhMyZshConfig": false,
			"upgradePackages": false
		},
		"ghcr.io/devcontainers-extra/features/apt-packages:1": {
			"packages": "python3-dev,build-essential,cmake,sudo"
		},
		// Keep in step with the uv image version in the Dockerfile: a different uv can rewrite uv.lock.
		"ghcr.io/devcontainers-extra/features/uv:1.0.2": { "version": "0.13.0" },
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/node:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	// A pinned uv version is resolved with `git ls-remote`, and the image has no git,
	// so git must be installed before the uv feature runs.
	"overrideFeatureInstallOrder": [
		"ghcr.io/devcontainers/features/common-utils",
		"ghcr.io/devcontainers/features/git",
		"ghcr.io/devcontainers-extra/features/apt-packages",
		"ghcr.io/devcontainers-extra/features/uv"
	],
	"postCreateCommand": "sudo chown ubuntu:ubuntu .venv && uv sync --frozen --no-install-project",
	"postStartCommand": "git config --global --replace-all --fixed-value safe.directory ${containerWorkspaceFolder} ${containerWorkspaceFolder} && sudo service nginx start",
	"forwardPorts": [80, 443, 5055, 5056],
	"portsAttributes": {
		"80": { "label": "PlaneSign HTTP", "protocol": "http" },
		"443": { "label": "PlaneSign HTTPS", "protocol": "https" },
		"5055": { "label": "Flask API" },
		"5056": { "label": "Emulated Display WebSocket" }
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.debugpy",
				"ms-azuretools.vscode-docker",
				"charliermarsh.ruff"
			]
		}
	}
}
