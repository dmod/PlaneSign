{
	"name": "Existing Dockerfile",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile",
		"args": {
			"PLANESIGN_ROOT": "/workspaces/PlaneSign"
		}
	},
	"runArgs": ["--privileged", "--network=host"],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.debugpy",
				"ms-azuretools.vscode-docker",
				"charliermarsh.ruff"
			]
		}
	}
}
