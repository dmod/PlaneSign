{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PlaneSign Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/planesign",
            "console": "integratedTerminal",
            "sudo": true
        },
        {
            "name": "PlaneSign Debug - devcontainer",
            "type": "debugpy",
            "python": "${workspaceFolder}/.venv/bin/python",
            "request": "launch",
            "program": "${workspaceFolder}/planesign",
            "console": "integratedTerminal",
            "preLaunchTask": "uv sync and start nginx"
        },
        {
            "name": "PlaneSign Debug - Web Display",
            "type": "debugpy",
            "python": "${workspaceFolder}/.venv/bin/python",
            "request": "launch",
            "program": "${workspaceFolder}/planesign",
            "args": ["--web"],
            "console": "integratedTerminal",
            "preLaunchTask": "uv sync and start nginx"
        },
        {
            "name": "Bluetooth Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "ble/planesign_ble.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Run Test Script",
            "type": "debugpy",
            "justMyCode": false,
            "request": "launch",
            "program": "${workspaceFolder}/test/test.py",
            "console": "integratedTerminal",
            "sudo": true
        },
        {
            "name": "Run Test Script - devcontainer",
            "type": "debugpy",
            "justMyCode": false,
            "request": "launch",
            "program": "${workspaceFolder}/test/test.py",
            "console": "integratedTerminal"
        }
    ]
}