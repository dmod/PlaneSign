{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PlaneSign Debug",
            "type": "debugpy",
            "python": "${workspaceFolder}/.venv/bin/python",
            "request": "launch",
            "program": "${workspaceFolder}/planesign",
            "console": "integratedTerminal",
            "sudo": true,
            "preLaunchTask": "uv sync and start nginx"
        },
        {
            "name": "PlaneSign Debug - Web Display",
            "type": "debugpy",
            "python": "${workspaceFolder}/.venv/bin/python",
            "request": "launch",
            "program": "${workspaceFolder}/planesign",
            "args": ["--web"],
            "console": "integratedTerminal",
            "preLaunchTask": "prepare PlaneSign Web Display",
            "serverReadyAction": {
                "pattern": "server listening on 0\\.0\\.0\\.0:5056",
                "uriFormat": "http://localhost/display",
                "action": "openExternally"
            }
        },
        {
            "name": "Bluetooth Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "ble/planesign_ble.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Run Test Script",
            "type": "debugpy",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "request": "launch",
            "program": "${workspaceFolder}/test/test.py",
            "console": "integratedTerminal",
            "sudo": true
        }
    ]
}